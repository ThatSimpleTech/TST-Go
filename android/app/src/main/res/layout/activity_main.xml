<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <org.osmdroid.views.MapView
        android:id="@+id/map"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:padding="12dp"
        android:paddingTop="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_chip"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="@string/app_name"
                android:textColor="@color/fg"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/logoChip"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_chip"
                android:gravity="center_vertical"
                android:paddingHorizontal="10dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@string/app_name"
                    android:src="@mipmap/ic_launcher" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_chip"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingEnd="4dp">

            <EditText
                android:id="@+id/search"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="@string/search_hint"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="text"
                android:paddingHorizontal="14dp"
                android:singleLine="true"
                android:textColor="@color/fg"
                android:textColorHint="@color/subtle"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/searchGo"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_go"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="@string/search_action"
                android:textColor="@color/live_fg"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/hud"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_chip"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/hudStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/idle_pin"
                android:textAllCaps="true"
                android:textColor="@color/subtle"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/hudCoords"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="monospace"
                android:text="40.758000, -73.985500"
                android:textColor="@color/fg"
                android:textIsSelectable="true"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/hudLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="Times Square"
                android:textColor="@color/muted"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/hudMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="monospace"
                android:text="0° N  ·  0.0 km/h"
                android:textColor="@color/muted"
                android:textSize="11sp" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/resultsScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_chip"
            android:fillViewport="true"
            android:maxHeight="200dp"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/results"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="6dp" />
        </ScrollView>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="bottom"
        android:orientation="vertical"
        android:padding="12dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:id="@+id/broadcastRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_chip"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/broadcast"
                    android:textColor="@color/fg"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/broadcastStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/broadcast_off"
                    android:textColor="@color/subtle"
                    android:textSize="11sp" />
            </LinearLayout>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/broadcastSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal">

            <com.thatsimpletech.tstgo.JoystickView
                android:id="@+id/joystick"
                android:layout_width="136dp"
                android:layout_height="136dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip"
                android:orientation="vertical"
                android:padding="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView android:id="@+id/modeJump" style="@style/ModeChip" android:text="@string/jump" />
                    <TextView android:id="@+id/modeWalk" style="@style/ModeChip" android:text="@string/walk" />
                    <TextView android:id="@+id/modeCycle" style="@style/ModeChip" android:text="@string/cycle" />
                    <TextView android:id="@+id/modeDrive" style="@style/ModeChip" android:text="@string/drive" />
                </LinearLayout>

                <TextView
                    android:id="@+id/goBtn"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_go"
                    android:gravity="center"
                    android:text="@string/go"
                    android:textAllCaps="true"
                    android:textColor="@color/live_fg"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
